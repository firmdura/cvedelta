{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "baseline": {
      "$ref": "metadata-v1.schema.json"
    },
    "candidate": {
      "$ref": "metadata-v1.schema.json"
    },
    "comparable": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "scanner_revision_changed",
              "database_changed",
              "coverage_scope_changed",
              "baseline_coverage_incomplete",
              "candidate_coverage_incomplete"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "$ref": "#/$defs/component"
          },
          "cve_id": {
            "type": "string",
            "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
          },
          "category": {
            "enum": [
              "new",
              "no_longer_reported",
              "status_changed",
              "context_changed",
              "unchanged"
            ]
          },
          "before": {
            "anyOf": [
              {
                "$ref": "#/$defs/context"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "$ref": "#/$defs/context"
              },
              {
                "type": "null"
              }
            ]
          },
          "absence_reason": {
            "anyOf": [
              {
                "enum": [
                  "component_absent",
                  "finding_absent"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "changed_fields": {
            "type": "array",
            "items": {
              "enum": [
                "version",
                "status",
                "detail",
                "description",
                "summary",
                "link",
                "modified",
                "scorev2",
                "scorev3",
                "scorev4",
                "vector",
                "vectorString"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "component",
          "cve_id",
          "category",
          "before",
          "after",
          "absence_reason",
          "changed_fields"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "category": {
                  "const": "new"
                }
              }
            },
            "then": {
              "properties": {
                "before": {
                  "type": "null"
                },
                "after": {
                  "$ref": "#/$defs/context"
                },
                "absence_reason": {
                  "type": "string"
                },
                "changed_fields": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "no_longer_reported"
                }
              }
            },
            "then": {
              "properties": {
                "before": {
                  "$ref": "#/$defs/context"
                },
                "after": {
                  "type": "null"
                },
                "absence_reason": {
                  "type": "string"
                },
                "changed_fields": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "enum": [
                    "status_changed",
                    "context_changed",
                    "unchanged"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "before": {
                  "$ref": "#/$defs/context"
                },
                "after": {
                  "$ref": "#/$defs/context"
                },
                "absence_reason": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "unchanged"
                }
              }
            },
            "then": {
              "properties": {
                "changed_fields": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "status_changed"
                }
              }
            },
            "then": {
              "properties": {
                "changed_fields": {
                  "contains": {
                    "const": "status"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "context_changed"
                }
              }
            },
            "then": {
              "properties": {
                "changed_fields": {
                  "minItems": 1,
                  "not": {
                    "contains": {
                      "const": "status"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "no_longer_reported": {
          "type": "integer",
          "minimum": 0
        },
        "status_changed": {
          "type": "integer",
          "minimum": 0
        },
        "context_changed": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "new",
        "no_longer_reported",
        "status_changed",
        "context_changed",
        "unchanged"
      ],
      "additionalProperties": false
    },
    "component_version_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "$ref": "#/$defs/component"
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "component",
          "before",
          "after"
        ],
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "fail_on": {
          "type": "array",
          "items": {
            "enum": [
              "new",
              "no_longer_reported",
              "status_changed",
              "context_changed"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "fail_on"
      ],
      "additionalProperties": false
    },
    "decision": {
      "enum": [
        "clean",
        "changes_detected",
        "incomparable"
      ]
    }
  },
  "required": [
    "schema_version",
    "baseline",
    "candidate",
    "comparable",
    "reasons",
    "records",
    "counts",
    "component_version_changes",
    "policy",
    "decision"
  ],
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "properties": {
        "layer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "layer",
        "name"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "Patched",
            "Unpatched",
            "Ignored"
          ]
        },
        "attributes": {
          "type": "object",
          "properties": {
            "detail": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "link": {
              "type": "string"
            },
            "modified": {
              "type": "string"
            },
            "scorev2": {
              "type": "string"
            },
            "scorev3": {
              "type": "string"
            },
            "scorev4": {
              "type": "string"
            },
            "vector": {
              "type": "string"
            },
            "vectorString": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "status",
        "attributes"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "comparable": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "const": "incomparable"
          },
          "reasons": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "decision": {
            "enum": [
              "clean",
              "changes_detected"
            ]
          },
          "reasons": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
